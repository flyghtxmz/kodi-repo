<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="plugin.video.flyghtxmz" name="Felipe Vídeos" version="1.0.0" provider-name="flyghtxmz">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
      <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="pt_BR">Addon inicial de vídeos para o Kodi</summary>
      <description lang="pt_BR">Addon de demonstração com vídeo de teste e suporte a uma URL própria configurável.</description>
      <disclaimer lang="pt_BR">Utilize apenas conteúdos que você tem direito de reproduzir.</disclaimer>
      <platform>all</platform>
      <language>pt</language>
      <source>https://github.com/flyghtxmz/kodi-repo</source>
    </extension>
  </addon>
  <addon id="repository.flyghtxmz" name="Felipe Addons - Repositório" version="1.0.0" provider-name="flyghtxmz">
    <extension point="xbmc.addon.repository">
      <dir>
        <info compressed="false">https://flyghtxmz.github.io/kodi-repo/addons.xml</info>
        <checksum>https://flyghtxmz.github.io/kodi-repo/addons.xml.md5</checksum>
        <datadir zip="true">https://flyghtxmz.github.io/kodi-repo/</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="pt_BR">Instale e atualize addons de Felipe pelo Kodi</summary>
      <description lang="pt_BR">Repositório independente para addons de vídeos e outros projetos futuros.</description>
      <platform>all</platform>
      <source>https://github.com/flyghtxmz/kodi-repo</source>
    </extension>
  </addon>
</addons>